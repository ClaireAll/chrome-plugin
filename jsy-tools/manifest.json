{
  "manifest_version": 3,
  "name": "jsy-tools",
  "version": "0.1.0",
  "description": "九数云效率工具：快捷上传 Excel、跨项目最近操作快捷栏。",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "打开 jsy-tools 配置", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["https://*.jiushuyun.com/decision/*", "http://localhost:10001/decision/*"],
      "js": ["import.js", "toolbar-icons.js", "recent-actions.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://*.jiushuyun.com/decision/*", "http://localhost:10001/decision/*"],
      "js": ["settings-bridge.js"],
      "run_at": "document_start"
    }
  ]
}
