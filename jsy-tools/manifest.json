{
  "manifest_version": 3,
  "name": "jsy-tools",
  "version": "0.1.5",
  "description": "九数云效率工具：快捷上传 Excel、最近操作快捷栏、项目级表数据预览开关、表格样式与快捷创建副本。",
  "minimum_chrome_version": "111",
  "permissions": ["storage"],
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "打开 jsy-tools 配置", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://*/decision/*"],
      "css": ["group-batch.css"],
      "js": ["import.js", "toolbar-icons.js", "recent-actions.js", "table-preview.js", "table-style-common.js", "table-style.js", "corp-identity.js", "recent-projects.js", "quick-copy.js", "tab-close.js", "automation-inline.js", "cross-project-reference.js", "quick-step-delete.js", "group-batch.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*/decision/*"],
      "js": ["settings-bridge.js", "corp-search.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.jdydevelop.com/dashboard", "*://*.jdydevelop.com/dashboard/", "*://*.jdydevelop.com/dashboard/*"],
      "js": ["corp-identity.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.jdydevelop.com/dashboard", "*://*.jdydevelop.com/dashboard/", "*://*.jdydevelop.com/dashboard/*"],
      "js": ["corp-search.js"],
      "run_at": "document_start"
    }
  ]
}
